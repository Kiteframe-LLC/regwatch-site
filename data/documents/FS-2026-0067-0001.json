  "pass_5_flaws": [
    {
      "flaw_key": "authority_substitution",
      "flaw_name": "Authority Substitution",
      "defect_type": "Type I",
      "severity": 2,
      "explanation": "The proposal uses an internal definition of advisory versus mandatory material to shrink the notice-and-comment universe, which risks substituting agency classification for a fuller statutory inquiry.",
      "evidence": [
        {
          "section": "\u00a7 216.1(b)",
          "quote_or_absence": "The part excludes advisory and informational guidance from notice and comment."
        }
      ],
      "comment_leverage": "Ask the agency to explain how it distinguishes true guidance from binding standards when the same handbook ecosystem can contain both."
    },
    {
      "flaw_key": "statutory_inversion",
      "flaw_name": "Statutory Inversion",
      "defect_type": "Type I",
      "severity": 3,
      "explanation": "The rule says rescission or removal of directives is not 'formulation,' which may invert the statute's procedural protection by taking a major directive change out of the comment process.",
      "evidence": [
        {
          "section": "\u00a7 216.1(b)",
          "quote_or_absence": "This part does not apply to the rescission or removal of directives."
        }
      ],
      "comment_leverage": "Ask for the statutory history or precedent that supports excluding rescissions from the FRRRPA comment requirement."
    },
    {
      "flaw_key": "accountability_inversion",
      "flaw_name": "Accountability Inversion",
      "defect_type": "Type I",
      "severity": 1,
      "explanation": "Manual departures must be documented, but handbook departures do not receive the same discipline, which can invert the level of accountability for material that may still matter in practice.",
      "evidence": [
        {
          "section": "\u00a7 200.4(b)(1)(i)-(ii)",
          "quote_or_absence": "Prompt documentation applies to Manual departures, but Handbook departures may occur without documentation."
        }
      ],
      "comment_leverage": "Ask whether the agency wants any logging or review requirement for Handbook deviations that affect external actors."
    },
